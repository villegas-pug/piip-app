{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "deny",
          "frontend-specialist": "allow",
          "backend-specialist": "allow",
          "frontend-specialist-plan": "deny",
          "backend-specialist-plan": "deny"
        }
      }
    },
    "plan": {
      "permission": {
        "task": {
          "*": "deny",
          "frontend-specialist-plan": "allow",
          "backend-specialist-plan": "allow",
          "frontend-specialist": "deny",
          "backend-specialist": "deny"
        }
      }
    }
  }
}
